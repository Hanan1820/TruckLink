            <div class="card-tl p-4 mt-4">
              <div class="sec-head"><div class="sec-ic"><i class="bi bi-toggle-on"></i></div>
                <div><h2 class="h-card">Availability</h2>
                     <p class="kv mb-0">Only <b>Active</b> staff can sign in and be assigned to a booking</p></div></div>
              <div class="row g-3">
                @{ PushWriter(new System.IO.StringWriter()); }
                  @await Html.PartialAsync("~/Views/Shared/_Sel.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["name"] = "staff_status", ["value"] = old("staff_status", member.StaffStatus), ["invalid"] = errors.Has("staff_status"), ["options"] = All(MapWithKeys(Collect(statusIcons),  (Func<dynamic, dynamic, dynamic>)((i, s) => new Dictionary<string, object?> { [s] = new Dictionary<string, object?> { ["label"] = s, ["icon"] = At(i, 0), ["colour"] = At(i, 1), ["boxIcon"] = s != "Active" } }))) }))
                @{ var __slot7 = new HtmlString(PopWriter().ToString()); }@await Html.PartialAsync("~/Views/Shared/_TrackedField.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["class"] = "col-12", ["name"] = "staff_status", ["label"] = "Status", ["required"] = true, ["track"] = editing, ["original"] = member.StaffStatus, ["icon"] = "bi-toggle-on", ["slot"] = __slot7 }))
              </div>
            </div>

@section Scripts {
<script>
  
  (function () {
    var title = document.querySelector('[name=job_title]');
    function sync() {
      document.querySelectorAll('[data-show-for]').forEach(function (box) {
        var on = box.dataset.showFor === title.value;
        box.hidden = !on;
        box.querySelectorAll('input:not([type=hidden])').forEach(function (i) { i.disabled = !on; if (i.name === 'license_number') i.required = on; });
        box.querySelectorAll('[data-sel-input]').forEach(function (i) { i.disabled = !on; });
      });
    }
    title.addEventListener('change', sync);
    sync();
    
    var start = document.getElementById('shift_start'), end = document.getElementById('shift_end');
    function shift() { end.min = start.value; end.setCustomValidity(start.value && end.value && end.value <= start.value ? 'The shift must end after it starts.' : ''); }
    start.addEventListener('input', shift);
    end.addEventListener('input', shift);
    shift();
  })();
</script>
}
