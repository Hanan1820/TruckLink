                @{ var __slot1 = new HtmlString(PopWriter().ToString()); }@await Html.PartialAsync("~/Views/Shared/_TrackedField.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["class"] = "col-6", ["name"] = "job_title", ["label"] = "Job title", ["required"] = true, ["track"] = editing, ["original"] = member.JobTitle, ["icon"] = "bi-briefcase", ["slot"] = __slot1 }))
                @{ PushWriter(new System.IO.StringWriter()); }
                  <input class="@Cls(new Dictionary<string, object?> { ["0"] = "fld", ["fld-err"] = errors.Has("hire_date") })" id="hire_date" name="hire_date" type="date" max="@(ToDateString(today()))" value="@(old("hire_date", ToDateString(member.HireDate)))" required>
                @{ var __slot2 = new HtmlString(PopWriter().ToString()); }@await Html.PartialAsync("~/Views/Shared/_TrackedField.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["class"] = "col-6", ["name"] = "hire_date", ["label"] = "Hire date", ["required"] = true, ["track"] = editing, ["original"] = ToDateString(member.HireDate), ["icon"] = "bi-calendar", ["slot"] = __slot2 }))
                @{ PushWriter(new System.IO.StringWriter()); }
                  <input class="@Cls(new Dictionary<string, object?> { ["0"] = "fld", ["fld-err"] = errors.Has("shift_start") })" id="shift_start" name="shift_start" type="time" value="@(old("shift_start", member.ShiftStartLabel))">
                @{ var __slot3 = new HtmlString(PopWriter().ToString()); }@await Html.PartialAsync("~/Views/Shared/_TrackedField.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["class"] = "col-6", ["name"] = "shift_start", ["label"] = "Shift start", ["track"] = editing, ["original"] = member.ShiftStartLabel, ["icon"] = "bi-clock", ["slot"] = __slot3 }))
                @{ PushWriter(new System.IO.StringWriter()); }
                  <input class="@Cls(new Dictionary<string, object?> { ["0"] = "fld", ["fld-err"] = errors.Has("shift_end") })" id="shift_end" name="shift_end" type="time" value="@(old("shift_end", member.ShiftEndLabel))" min="@(old("shift_start", member.ShiftStartLabel))">
                @{ var __slot4 = new HtmlString(PopWriter().ToString()); }@await Html.PartialAsync("~/Views/Shared/_TrackedField.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["class"] = "col-6", ["name"] = "shift_end", ["label"] = "Shift end", ["track"] = editing, ["original"] = member.ShiftEndLabel, ["icon"] = "bi-clock-history", ["slot"] = __slot4 }))
                @{ PushWriter(new System.IO.StringWriter()); }
                  <input class="@Cls(new Dictionary<string, object?> { ["0"] = "fld", ["fld-err"] = errors.Has("license_number") })" id="license_number" name="license_number" value="@(old("license_number", member.LicenseNumber))" maxlength="30" style="text-transform:uppercase" autocomplete="off" @(title == "Driver" ? "required" : "") @(title != "Driver" ? "disabled" : "")>
                @{ var __slot5 = new HtmlString(PopWriter().ToString()); }@await Html.PartialAsync("~/Views/Shared/_TrackedField.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["class"] = "col-6", ["name"] = "license_number", ["label"] = "Licence number", ["required"] = true, ["track"] = editing, ["original"] = member.LicenseNumber, ["format"] = "upper", ["icon"] = "bi-person-badge", ["hint"] = "Driving licence - required for drivers", ["data-show-for"] = "Driver", ["hidden"] = title != "Driver", ["slot"] = __slot5 }))
                @{ PushWriter(new System.IO.StringWriter()); }
                  @await Html.PartialAsync("~/Views/Shared/_Sel.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["name"] = "specialty", ["value"] = old("specialty", member.Specialty), ["options"] = new Dictionary<string, object?> { [""] = new Dictionary<string, object?> { ["label"] = "None" } } + All(MapWithKeys(Collect(TruckLink.Models.Staff.SPECIALTIES),  (Func<dynamic, dynamic>)((s) => new Dictionary<string, object?> { [s] = new Dictionary<string, object?> { ["label"] = Ucfirst(s) } }))) }))
                @{ var __slot6 = new HtmlString(PopWriter().ToString()); }@await Html.PartialAsync("~/Views/Shared/_TrackedField.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["class"] = "col-6", ["name"] = "specialty", ["label"] = "Specialty", ["track"] = editing, ["original"] = member.Specialty, ["icon"] = "bi-tools", ["display"] = new Dictionary<string, object?> { [""] = "None" } + ArrayCombine(TruckLink.Models.Staff.SPECIALTIES, ArrayMap("ucfirst", TruckLink.Models.Staff.SPECIALTIES)), ["hint"] = "Movers with a specialty are proposed first when a booking includes it", ["data-show-for"] = "Mover", ["hidden"] = title != "Mover", ["slot"] = __slot6 }))
