
@{ Layout = "~/Views/Admin/Crud/FormPage.cshtml"; }
@{
    dynamic member = ViewData["member"];
}

@{
dynamic page = new Dictionary<string, object?> { ["title"] = "Add a Staff Member", ["sub"] = "Register a driver, mover or warehouse keeper so they can be assigned to bookings", ["crumbs"] = new object[] { new object[] { "Staff", route("admin.staff.index") } }, ["current"] = "New Staff Member", ["action"] = route("admin.staff.store"), ["cancel"] = route("admin.staff.index"), ["save"] = "Save Staff Member", ["editing"] = false, ["search"] = new object[] { "Search staff by name, email, phone or licence", route("admin.staff.index") }, ["uses"] = new object[] { new object[] { "Booking assignment", "Drivers and movers are offered when a request is accepted" }, new object[] { "Job app", "Signs in to the staff app to see and update assigned jobs" }, new object[] { "Staff reports", "Completed jobs, working hours and customer ratings" } } };
dynamic admin = User(auth("admin"));
}


@section Cards {
            @await Html.PartialAsync("~/Views/Admin/Staff/_Form.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["editing"] = false }))
}

@section Preview {
            <div class="card-tl p-4 summary">
              <div class="cap mb-3">Preview</div>
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="veh-ic"><i class="bi @(At(TruckLink.Models.Staff.TITLE_ICONS, old("job_title", member.JobTitle)) ?? "bi-person")" data-preview-icon></i></div>
                <div><div style="font-weight:700;font-size:15px" data-preview-name>@((Truthy(Trim(old("first_name") + " " + old("last_name"))) ? Trim(old("first_name") + " " + old("last_name")) : "-"))</div>
                     <div class="kv" data-preview-title>@((Truthy(old("job_title")) ? old("job_title") : "-"))</div></div>
              </div>
              <div class="row g-2">
                <div class="col-6"><div class="tile"><div class="k">Shift</div>
                     <div class="v" style="font-size:16px" data-preview-shift>@(old("shift_start") ? old("shift_start") + "–" + old("shift_end") : "-")</div></div></div>
                <div class="col-6"><div class="tile"><div class="k">Added by</div>
                     <div class="v" style="font-size:16px">@(admin.FirstName)</div><div class="u">@(admin.Code)</div></div></div>
              </div>
            </div>
}

@section Scripts {
<script>
  (function () {
    var form = document.getElementById('record-form'), icons = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TruckLink.Models.Staff.TITLE_ICONS));
    function val(n) { var f = form.querySelector('[name=' + n + ']'); return f ? f.value.trim() : ''; }
    function paint() {
      document.querySelector('[data-preview-name]').textContent = (val('first_name') + ' ' + val('last_name')).trim() || '-';
      document.querySelector('[data-preview-title]').textContent = val('job_title') || '-';
      document.querySelector('[data-preview-icon]').className = 'bi ' + (icons[val('job_title')] || 'bi-person');
      document.querySelector('[data-preview-shift]').textContent = val('shift_start') && val('shift_end') ? val('shift_start') + '–' + val('shift_end') : '-';
    }
    form.addEventListener('input', paint);
    form.addEventListener('change', paint);
  })();
</script>
}
