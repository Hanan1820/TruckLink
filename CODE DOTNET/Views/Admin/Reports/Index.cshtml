
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
@{
    dynamic types = ViewData["types"];
}



@{ ViewData["title"] = "Reports"; }

@section Content {
        <div class="crumb"><a href="@(url("admin/dashboard"))" class="text-reset text-decoration-none">Dashboard</a> <i class="bi bi-chevron-right" style="font-size:9px"></i> <b>Reports</b></div>
        <div class="d-flex justify-content-between align-items-end mb-4">
          <div><h1 class="h-page">Reports</h1>
               <p class="h-sub">Pick a report; each one can be filtered by period and printed</p></div>
        </div>
        <div class="row g-4">
          @foreach (var (key, __v9) in Pairs((object?)(types))) {
dynamic title = At(__v9, 0);
dynamic icon = At(__v9, 1);
dynamic text = At(__v9, 2);<text>
          <div class="col-4">
            <a class="pick d-flex align-items-start gap-3 h-100 text-reset text-decoration-none" href="@(route("admin.reports.show", key))">
              <div class="ic-box"><i class="bi @(icon)"></i></div>
              <div style="flex:1"><div style="font-weight:700;font-size:15px">@(title)</div>
                   <div class="kv">@(text)</div></div>
              <i class="bi bi-chevron-right" style="color:var(--s)"></i>
            </a>
          </div>
          </text>}
        </div>
}
