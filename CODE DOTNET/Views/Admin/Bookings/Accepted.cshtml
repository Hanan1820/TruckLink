
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
@{
    dynamic booking = ViewData["booking"];
    dynamic crew = ViewData["crew"];
    dynamic justAccepted = ViewData["justAccepted"];
    dynamic next = ViewData["next"];
    dynamic notifications = ViewData["notifications"];
}




@{ ViewData["title"] = booking.Reference + " accepted"; }

@{
dynamic pickup = booking.PickupDatetime;
dynamic vehicle = booking.Vehicle;
dynamic driver = booking.Driver;
dynamic storage = booking.StorageRequest;
dynamic customerNote = FirstWhere(notifications, "announcement_type", "Booking Accepted");
dynamic driverNote = First(notifications,  (Func<dynamic, dynamic>)((n) => n.AnnouncementType == "Job Assigned" && n.StaffId == driver?.StaffId));
dynamic crewNotes = Filter(notifications,  (Func<dynamic, dynamic>)((n) => n.AnnouncementType == "Job Assigned" && n.StaffId != driver?.StaffId));
}

@section Content {
        @if (Truthy(justAccepted)) {<text>
        <div class="al a-ok mb-4"><i class="bi bi-check-circle-fill" style="font-size:20px"></i><div><strong>Request accepted.</strong> @(booking.Customer.FullName)@(IsNotEmpty(crew) ? " and the assigned crew have" : " has") been notified, and @(vehicle?.PlateNumber) is now reserved for @(Format(pickup, "d F")).</div></div>
        </text>}
        <div class="card-tl text-center mb-3" style="padding:44px 40px">
          @await Html.PartialAsync("~/Views/Svg/SuccessBookingConfirmed.cshtml")
          <h1 class="h-page" style="font-size:25px">Booking @(booking.Reference) is confirmed</h1>
          <p class="kv" style="max-width:520px;margin:10px auto 0;font-size:14.5px">The job is scheduled for @(Format(pickup, "l d F")) at @(Format(pickup, "H:i")) and now appears in the driver's app.</p>
          <div class="mt-4">@await Component.InvokeAsync("StatusPill", new Dictionary<string, object?> { ["value"] = "Accepted", ["icon"] = "bi-check-circle-fill", ["style"] = "font-size:14px;padding:10px 20px" })</div>
        </div>
        <div class="row g-3">
          <div class="col-8">
            <div class="card-tl" style="padding:24px">
              <div class="sec-head"><div class="sec-ic"><i class="bi bi-clipboard-check"></i></div><div><h2 class="h-card">Assigned resources</h2><p class="kv mb-0">Reserved for @(Format(pickup, "d M, H:i")) – @(Format(AddHours(Copy(pickup), TruckLink.Support.Services.BookingAcceptance.SLOT_HOURS), "H:i"))</p></div></div>
              <div class="row g-3">
                <div class="col-6"><div class="pick d-flex align-items-center gap-3">@await Html.PartialAsync("~/Views/Svg/AssignedVehicle.cshtml")<div><div style="font-weight:700;font-size:15px">@(vehicle?.PlateNumber)</div><div class="kv">@(vehicle?.VehicleType) · @(Num(vehicle?.CapacityVolumeM3)) m³</div></div>@await Component.InvokeAsync("StatusPill", new Dictionary<string, object?> { ["value"] = "On Job", ["class"] = "ms-auto" })</div></div>
                <div class="col-6"><div class="pick d-flex align-items-center gap-3">@await Component.InvokeAsync("Avatar", new Dictionary<string, object?> { ["first"] = driver?.FirstName, ["last"] = driver?.LastName, ["style"] = "width:42px;height:42px;font-size:14px" })<div><div style="font-weight:700;font-size:15px">@(driver?.FullName)</div><div class="kv">Driver · notified</div></div>@await Component.InvokeAsync("StatusPill", new Dictionary<string, object?> { ["value"] = "Assigned", ["class"] = "ms-auto" })</div></div>
                @if (Truthy(IsNotEmpty(crew))) {<text>
                <div class="col-12"><div class="pick d-flex align-items-center gap-3">
                  <div class="ic-box"><i class="bi bi-people-fill"></i></div>
                  <div style="flex:1"><div style="font-weight:700;font-size:15px">Moving crew - @(Count(crew)) @(Plural("member", Count(crew)))</div><div class="kv">@(Implode(crew.Map.FullName, " · "))</div></div>
                  <div class="d-flex gap-1">@foreach (var mover in crew) {<text>@await Component.InvokeAsync("Avatar", new Dictionary<string, object?> { ["first"] = mover.FirstName, ["last"] = mover.LastName, ["sm"] = true })</text>}</div></div></div>
                </text>}
                @if (Truthy(storage)) {<text>
                <div class="col-12"><div class="pick d-flex align-items-center gap-3">
                  <div class="ic-box"><i class="bi bi-buildings-fill"></i></div>
                  <div style="flex:1"><div style="font-weight:700;font-size:15px">@(storage.Warehouse.WarehouseName)</div><div class="kv">Storage slot reserved · free period @(IsSameMonth(storage.StartDate, storage.FreePeriodEndDate) ? Format(storage.StartDate, "d") : Format(storage.StartDate, "d M"))–@(Format(storage.FreePeriodEndDate, "d M")) · keeper @(storage.Warehouse.Keeper?.FullName)</div></div>
                  @await Component.InvokeAsync("StatusPill", new Dictionary<string, object?> { ["value"] = storage.StorageStatus, ["class"] = "ms-auto" })</div></div>
                </text>}
              </div>
            </div>
          </div>
          <div class="col-4">
            <div class="card-tl mb-3" style="padding:22px">
              <div class="cap mb-3">Notifications sent</div>
              @{
dynamic rows = ArrayValues(ArrayFilter(new object[] { customerNote ? new object[] { booking.Customer.FullName, "Booking accepted · vehicle and crew confirmed" } : null, driverNote ? new object[] { driver.FullName, "New job assigned for " + Format(pickup, "d M, H:i") } : null, IsNotEmpty(crewNotes) ? new object[] { "Moving crew (" + Count(crewNotes) + ")", "Assignment and address details sent" } : null }));
}
              @if (!IsEmpty(rows)) {<text>
@foreach (var (__v2, loop) in WithLoop((object?)(rows))) {
dynamic who = At(__v2, 0);
dynamic what = At(__v2, 1);<text>
              <div class="@Cls(new Dictionary<string, object?> { ["0"] = "d-flex gap-2 align-items-start", ["mb-3"] = !loop.Last })"><i class="bi bi-check-circle-fill" style="color:var(--ok);font-size:15px;margin-top:2px"></i><div><div style="font-size:13.5px;font-weight:600">@(who)</div><div class="kv" style="font-size:12.5px">@(what)</div></div></div>
              </text>}
</text>} else {<text>
              <div class="kv">No notifications recorded for this booking.</div>
              </text>}
            </div>
            @if (Truthy(next)) {<text>
            <a class="btn btn-tl b-lg w-100 mb-2" href="@(route("admin.bookings.show", next))"><i class="bi bi-clipboard-check"></i> Review next request</a>
            </text>} else {<text>
            <button type="button" class="btn btn-dis b-lg w-100 mb-2" disabled><i class="bi bi-clipboard-check"></i> No more requests</button>
            </text>}
            <a class="btn btn-out b-md w-100" href="@(route("admin.bookings.index"))">Back to bookings</a>
          </div>
        </div>
}
