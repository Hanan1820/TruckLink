
@{ Layout = "~/Views/Admin/Crud/FormPage.cshtml"; }

@{
dynamic page = new Dictionary<string, object?> { ["title"] = "Add an Item Category", ["sub"] = "Add a kind of item customers can book, matched with the vehicle it needs", ["crumbs"] = new object[] { new object[] { "Item Categories", route("admin.item-categories.index") } }, ["current"] = "New Category", ["action"] = route("admin.item-categories.store"), ["cancel"] = route("admin.item-categories.index"), ["save"] = "Save Category", ["editing"] = false, ["search"] = new object[] { "Search categories by name or description", route("admin.item-categories.index") }, ["uses"] = new object[] { new object[] { "Add items (step 3)", "Chosen by the customer for every item" }, new object[] { "Measurement (step 4)", "Sets the typical size, weight and the recommended vehicle" }, new object[] { "Booking review", "Shown on every item in the request" } } };
}


@section Cards {
            @await Html.PartialAsync("~/Views/Admin/Categories/_Form.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["editing"] = false }))
}

@section Preview {
            <div class="card-tl p-4 summary">
              <div class="cap mb-3">Preview</div>
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="veh-ic"><i class="bi bi-grid-3x3-gap"></i></div>
                <div><div style="font-weight:700;font-size:15px" data-preview-name>@((Truthy(old("category_name")) ? old("category_name") : "-"))</div>
                     <div class="kv" data-preview-vehicle>@((Truthy(old("recommended_vehicle_type")) ? old("recommended_vehicle_type") : "-"))</div></div>
              </div>
              <div class="d-flex gap-2"><span class="pill p-neu" data-preview-temp="0">Standard</span><span class="pill p-info" data-preview-temp="1" hidden><i class="bi bi-snow"></i> Refrigerated</span></div>
            </div>
}

@section Scripts {
<script>
  (function () {
    var form = document.getElementById('record-form');
    function paint() {
      var temp = form.querySelector('[name=requires_temperature_control]:checked');
      document.querySelector('[data-preview-name]').textContent = form.querySelector('[name=category_name]').value.trim() || '-';
      document.querySelector('[data-preview-vehicle]').textContent = form.querySelector('[name=recommended_vehicle_type]').value || '-';
      document.querySelectorAll('[data-preview-temp]').forEach(function (p) { p.hidden = p.dataset.previewTemp !== (temp ? temp.value : '0'); });
    }
    form.addEventListener('input', paint);
    form.addEventListener('change', paint);
    paint();
  })();
</script>
}
