
@{ Layout = "~/Views/Admin/Crud/FormPage.cshtml"; }
@{
    dynamic account = ViewData["account"];
}

@{
dynamic page = new Dictionary<string, object?> { ["title"] = "Add an Admin", ["sub"] = "Give a colleague access to the TruckLink admin panel", ["crumbs"] = new object[] { new object[] { "Admin accounts", route("admin.admins.index") } }, ["current"] = "New Admin", ["action"] = route("admin.admins.store"), ["cancel"] = route("admin.admins.index"), ["save"] = "Save Admin", ["editing"] = false, ["search"] = new object[] { "Search admins by name or email", route("admin.admins.index") }, ["uses"] = new object[] { new object[] { "Booking review", "Accepts and rejects booking requests and assigns resources" }, new object[] { "Fleet, staff & catalogue", "Registers vehicles, staff, services and item categories" }, new object[] { "Announcements", "Sends announcements to customers and staff" } } };
}


@section Cards {
            @await Html.PartialAsync("~/Views/Admin/Admins/_Form.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["editing"] = false }))
}

@section Preview {
            <div class="card-tl p-4 summary">
              <div class="cap mb-3">Preview</div>
              <div class="d-flex align-items-center gap-3">
                <div class="veh-ic"><i class="bi bi-person-badge"></i></div>
                <div><div style="font-weight:700;font-size:15px" data-preview-name>@((Truthy(Trim(old("first_name") + " " + old("last_name"))) ? Trim(old("first_name") + " " + old("last_name")) : "-"))</div>
                     <div class="kv" data-preview-role>@(old("admin_role", account.AdminRole))</div></div>
              </div>
            </div>
}

@section Scripts {
<script>
  (function () {
    var form = document.getElementById('record-form');
    function val(n) { var f = form.querySelector('[name=' + n + ']'); return f ? f.value.trim() : ''; }
    function paint() {
      document.querySelector('[data-preview-name]').textContent = (val('first_name') + ' ' + val('last_name')).trim() || '-';
      document.querySelector('[data-preview-role]').textContent = val('admin_role');
    }
    form.addEventListener('input', paint);
    form.addEventListener('change', paint);
  })();
</script>
}
