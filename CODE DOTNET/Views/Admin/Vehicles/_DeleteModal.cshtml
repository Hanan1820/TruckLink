
@{
    dynamic acceptedCount = ViewData["acceptedCount"];
    dynamic completedCount = ViewData["completedCount"];
    dynamic references = ViewData["references"];
    dynamic upcoming = ViewData["upcoming"];
    dynamic vehicle = ViewData["vehicle"];
}



@{
dynamic inUse = references > 0;
dynamic others = references - acceptedCount - completedCount;
dynamic uses = ArrayFilter(new object[] { acceptedCount ? "is assigned to <b>" + acceptedCount + " accepted " + Plural("booking", acceptedCount) + "</b>" : null, completedCount ? "appears in <b>" + completedCount + " completed trip " + Plural("record", completedCount) + "</b>" : null, others ? "is referenced by <b>" + others + " other booking " + Plural("record", others) + "</b>" : null });
dynamic refs = All(Pluck(upcoming, "reference"));
dynamic isOut = vehicle.VehicleStatus == "Out of Service";
}
@{ PushWriter(new System.IO.StringWriter()); }
          <div class="m-head d-flex align-items-start gap-3">
            <div class="sec-ic" style="background:var(--dgb);color:var(--dg)">
              <i class="bi bi-trash3-fill"></i></div>
            <div style="flex:1">
              <h2 class="h-card" id="delete-vehicle-title">Delete vehicle @(vehicle.PlateNumber)?</h2>
              <p class="kv mb-0">This permanently removes record
                 <span class="mono-d">@(vehicle.Code)</span> from the <b>vehicle</b> table.
                 This action cannot be undone.</p>
            </div>
            <i class="bi bi-x-lg" data-modal-close role="button" tabindex="0" aria-label="Close" style="color:var(--mu);font-size:17px;cursor:pointer"></i>
          </div>
          <div class="m-body">
            <div class="conf d-flex align-items-center gap-3 mb-4">
              <div class="veh-ic"><i class="bi @(vehicle.Icon)"></i></div>
              <div style="flex:1">
                <div class="mono-d" style="font-weight:700;font-size:15px">@(vehicle.PlateNumber)</div>
                <div class="kv">@(vehicle.VehicleType) &#183; @(NumberFormat(vehicle.CapacityVolumeM3, 2)) m&#179; &#183; @(NumberFormat(vehicle.MaxWeightKg)) kg &#183;
                     registered @(Format(vehicle.CreatedAt, "d M Y"))</div>
              </div>
              @await Component.InvokeAsync("StatusPill", new Dictionary<string, object?> { ["value"] = vehicle.VehicleStatus, ["icon"] = TruckLink.Models.Vehicle.StatusIcon(vehicle.VehicleStatus, true) })
            </div>

            @if (Truthy(inUse)) {<text>
            <div class="al a-dg mb-4"><i class="bi bi-exclamation-octagon-fill" style="font-size:19px"></i>
              <div><b>This vehicle is still in use.</b>
                <div style="margin-top:7px">It @Html.Raw(ArrJoin(uses, ", ", " and ")). Deleting it would break those references.</div></div></div>
            </text>}

            <div class="cap mb-3">Choose how to proceed</div>
            <label class="@Cls(new Dictionary<string, object?> { ["0"] = "d-flex align-items-start gap-3 mb-3", ["pick-on"] = inUse, ["pick"] = !inUse })" style="cursor:pointer" data-proceed>
              <input class="visually-hidden" type="radio" name="proceed" value="out" @(Truthy(inUse) ? "checked" : "")>
              <i class="@Cls(new Dictionary<string, object?> { ["0"] = "bi", ["bi-check-circle-fill"] = inUse, ["bi-circle"] = !inUse })" style="color:var(@(inUse ? "--p" : "--line2"));font-size:19px;margin-top:2px" data-proceed-icon></i>
              <div style="flex:1">
                <div style="font-weight:700;font-size:14.5px">Set status to Out of Service
                  <span class="pill p-ok ms-2" style="font-size:11px;padding:3px 9px">Recommended</span></div>
                <div class="kv">The record is kept for reporting and history, but the vehicle is removed
                  from the recommendation pool and can no longer be assigned.</div>
              </div>
            </label>
            @if (Truthy(IsNotEmpty(upcoming))) {<text>
            <a class="pick d-flex align-items-start gap-3 mb-3 text-reset text-decoration-none" href="@(route("admin.bookings.index", new Dictionary<string, object?> { ["status"] = "accepted", ["q"] = vehicle.PlateNumber }))">
              <i class="bi bi-circle" style="color:var(--line2);font-size:19px;margin-top:2px"></i>
              <div style="flex:1">
                <div style="font-weight:700;font-size:14.5px">Reassign the @(Count(upcoming)) @(Plural("booking", Count(upcoming))), then delete</div>
                <div class="kv">Opens the booking queue so another available vehicle can be assigned
                  to @(ArrJoin(refs, ", ", " and ")) first.</div>
              </div>
            </a>
            </text>}
            <div class="pick-wn d-flex align-items-start gap-3" style="cursor:pointer" data-proceed>
              <input class="visually-hidden" type="radio" name="proceed" value="delete" @(!inUse ? "checked" : "")>
              <i class="@Cls(new Dictionary<string, object?> { ["0"] = "bi", ["bi-check-circle-fill"] = !inUse, ["bi-circle"] = inUse })" style="color:var(--wn);font-size:19px;margin-top:2px" data-proceed-icon></i>
              <div style="flex:1">
                <div style="font-weight:700;font-size:14.5px">Delete permanently</div>
                <div class="kv mb-3">Available only once no active booking references this vehicle.</div>
                @await Component.InvokeAsync("Field", new Dictionary<string, object?> { ["name"] = "confirm_plate", ["label"] = "Type the plate number to confirm", ["form"] = "delete-vehicle-form", ["style"] = "max-width:280px", ["placeholder"] = vehicle.PlateNumber, ["autocomplete"] = "off", ["maxlength"] = "20", ["hint"] = "Confirmation is required for a permanent delete.", ["data-confirm-plate"] = $"{vehicle.PlateNumber}" })
              </div>
            </div>
          </div>
          <div class="m-foot d-flex align-items-center">
            <div class="ms-auto d-flex gap-2">
              <a class="btn btn-out b-md" href="@(route("admin.vehicles.show", vehicle))" data-modal-close>Cancel</a>
              <form method="POST" action="@(route("admin.vehicles.destroy", vehicle))" id="delete-vehicle-form" class="d-flex">
                @Html.AntiForgeryToken() <input type="hidden" name="_method" value="DELETE"> 
                <button type="submit" class="btn btn-dis b-md" disabled data-delete-button><i class="bi bi-trash3"></i> Delete permanently</button>
              </form>
              <form method="POST" action="@(route("admin.vehicles.out-of-service", vehicle))" class="d-flex">
                @Html.AntiForgeryToken()
                <button type="submit" class="@Cls(new Dictionary<string, object?> { ["0"] = "btn b-md", ["btn-tl"] = !isOut, ["btn-dis"] = isOut })" @(Truthy(isOut) ? "disabled" : "")><i class="bi bi-shield-check"></i> Set Out of Service</button>
              </form>
            </div>
          </div>
@{ var __slot1 = new HtmlString(PopWriter().ToString()); }@await Html.PartialAsync("~/Views/Shared/_Modal.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["id"] = "delete-vehicle", ["wide"] = true, ["open"] = Boolean(request(), "delete") || errors.Has("confirm_plate"), ["label"] = "delete-vehicle-title", ["slot"] = __slot1 }))

@section Scripts {
<script>
  
  
  (function () {
    var modal = document.getElementById('delete-vehicle'), inUse = @(inUse ? "true" : "false");
    var confirmField = modal.querySelector('[data-confirm-plate]'), button = modal.querySelector('[data-delete-button]');
    function paint() {
      modal.querySelectorAll('[data-proceed]').forEach(function (card) {
        var on = card.querySelector('input').checked, icon = card.querySelector('[data-proceed-icon]');
        if (!card.classList.contains('pick-wn')) { card.classList.toggle('pick-on', on); card.classList.toggle('pick', !on); icon.style.color = on ? 'var(--p)' : 'var(--line2)'; }
        icon.classList.toggle('bi-check-circle-fill', on);
        icon.classList.toggle('bi-circle', !on);
      });
      var allowed = !inUse && confirmField.value.trim().replace(/\s+/g, ' ').toUpperCase() === confirmField.dataset.confirmPlate;
      button.disabled = !allowed;
      button.classList.toggle('btn-dis', !allowed);
      button.classList.toggle('btn-dg', allowed);
    }
    modal.addEventListener('change', paint);
    
    modal.querySelector('.pick-wn[data-proceed]').addEventListener('click', function () {
      this.querySelector('input[type=radio]').checked = true;
      paint();
    });
    confirmField.addEventListener('input', function () {
      modal.querySelector('[name=proceed][value=delete]').checked = true;
      paint();
    });
    paint();
  })();
</script>
}
