
@{
    dynamic shellUser = ViewData["shellUser"];
}

<a class="@Cls(new Dictionary<string, object?> { ["0"] = "side-i", ["side-on"] = IsModel(request(), "staff/jobs*") })" href="@(url("staff/jobs"))"><i class="bi bi-clipboard-check"></i> My Jobs</a>
<a class="@Cls(new Dictionary<string, object?> { ["0"] = "side-i", ["side-on"] = IsModel(request(), "staff/messages*") })" href="@(url("staff/messages"))"><i class="bi bi-chat-dots"></i> Messages</a>
@if (shellUser?.JobTitle == "Warehouse Keeper") {<text>
<a class="@Cls(new Dictionary<string, object?> { ["0"] = "side-i", ["side-on"] = IsModel(request(), "staff/warehouse*") })" href="@(url("staff/warehouse"))"><i class="bi bi-buildings"></i> Warehouse</a>
</text>}
<a class="@Cls(new Dictionary<string, object?> { ["0"] = "side-i", ["side-on"] = IsModel(request(), "staff/reviews*") })" href="@(url("staff/reviews"))"><i class="bi bi-star"></i> Reviews</a>
<a class="@Cls(new Dictionary<string, object?> { ["0"] = "side-i", ["side-on"] = IsModel(request(), "staff/reports*") })" href="@(url("staff/reports"))"><i class="bi bi-bar-chart"></i> Reports</a>
<a class="@Cls(new Dictionary<string, object?> { ["0"] = "side-i", ["side-on"] = IsModel(request(), "staff/profile*") })" href="@(url("staff/profile"))"><i class="bi bi-person"></i> Profile</a>
