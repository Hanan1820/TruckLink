
@{
    dynamic label = ViewData["label"];
    dynamic paginator = ViewData["paginator"];
}


@if (Total(paginator) > 0) {<text>
@{
dynamic current = CurrentPage(paginator);
dynamic last = LastPage(paginator);
dynamic pages = last <= 7 ? Range(1, last) : ArrayValues(ArrayUnique(ArrayFilter(new object[] { 1, current - 1, current, current + 1, last },  (Func<dynamic, dynamic>)((p) => p >= 1 && p <= last))));
}
<div class="p-3 px-4 d-flex justify-content-between align-items-center" style="background:#F9FBFC;border-top:1px solid var(--line)">
  <span class="kv">Showing @(FirstItem(paginator))–@(LastItem(paginator)) of @(Total(paginator)) @(label)</span>
  <div class="d-flex align-items-center gap-2">
    @if (Truthy(OnFirstPage(paginator))) {<text>
    <span class="btn btn-out b-sm b-ico" aria-disabled="true"><i class="bi bi-chevron-left"></i></span>
    </text>} else {<text>
    <a class="btn btn-out b-sm b-ico" href="@(PreviousPageUrl(paginator))" aria-label="Previous page"><i class="bi bi-chevron-left"></i></a>
    </text>}
    @foreach (var page in pages) {<text>
    <a class="@Cls(new Dictionary<string, object?> { ["0"] = "btn b-sm", ["btn-tl"] = page == current, ["btn-out"] = page != current })" style="width:34px" href="@(PageUrl(paginator, page))" @Html.Raw((page == current ? " aria-current=\"page\" " : ""))>@(page)</a>
    </text>}
    @if (Truthy(paginator.HasMorePages())) {<text>
    <a class="btn btn-out b-sm b-ico" href="@(paginator.NextPageUrl())" aria-label="Next page"><i class="bi bi-chevron-right"></i></a>
    </text>} else {<text>
    <span class="btn btn-out b-sm b-ico" aria-disabled="true"><i class="bi bi-chevron-right"></i></span>
    </text>}
  </div>
</div>
</text>}
