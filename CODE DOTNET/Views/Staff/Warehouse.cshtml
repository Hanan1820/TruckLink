
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
@{
    dynamic byStatus = ViewData["byStatus"];
    dynamic keeping = ViewData["keeping"];
    dynamic requests = ViewData["requests"];
    dynamic status = ViewData["status"];
    dynamic warehouses = ViewData["warehouses"];
}




@{ ViewData["title"] = "Warehouse"; }

@{
dynamic total = (int)Sum(byStatus);
}

@section Content {
        @if (Truthy(session("status"))) {<text>
        <div class="al a-ok mb-4"><i class="bi bi-check-circle-fill" style="font-size:19px"></i><div>@(session("status"))</div></div>
        </text>}
        @if (Truthy(errors.Any())) {<text>
        <div class="al a-dg mb-4"><i class="bi bi-exclamation-octagon-fill" style="font-size:19px"></i><div>@(errors.First())</div></div>
        </text>}
        <div class="crumb"><b>Warehouse</b></div>
        <div class="d-flex justify-content-between align-items-end mb-3">
          <div><h1 class="h-page">@(Count(warehouses) == 1 ? First(warehouses).WarehouseName : "My warehouses")</h1>
               <p class="h-sub">Record what comes in, where it is kept, and what goes out</p></div>
        </div>
        <div class="row g-4 mb-4">
          @if (!IsEmpty(warehouses)) {<text>
@foreach (var warehouse in warehouses) {<text>
          <div class="col-6"><div class="card-tl p-4 h-100">
            <div class="d-flex justify-content-between mb-2"><span class="kv"><b>@(warehouse.WarehouseName) · occupancy</b></span><span class="kv"><b>@(warehouse.OccupancyPercent)%</b></span></div>
            <div class="bar-track"><div class="bar-fill" style="width:@(warehouse.OccupancyPercent)%;background:var(@(warehouse.OccupancyPercent >= 90 ? "--dg" : (warehouse.OccupancyPercent >= 75 ? "--wn" : "--p")))"></div></div>
            <div class="hint mb-3">@(Num(warehouse.UsedCapacityM3)) of @(Num(warehouse.TotalCapacityM3)) m&#179; used · @(Num(warehouse.TotalCapacityM3 - warehouse.UsedCapacityM3)) m&#179; free</div>
            <div class="row g-2">
              <div class="col-6"><div class="tile"><div class="k">Opening hours</div><div class="v" style="font-size:15px">@(warehouse.OpeningHours)</div></div></div>
              <div class="col-6"><div class="tile"><div class="k">City</div><div class="v" style="font-size:15px">@(warehouse.City)</div></div></div>
            </div>
          </div></div>
          </text>}
</text>} else {<text>
          <div class="col-12"><div class="al a-in"><i class="bi bi-info-circle-fill" style="font-size:18px"></i><div>No warehouse is assigned to you yet. Ask your operations admin.</div></div></div>
          </text>}
        </div>
        <div class="d-flex gap-2 mb-3 align-items-center">
          <a class="@Cls(new Dictionary<string, object?> { ["0"] = "chip text-decoration-none", ["chip-on"] = !status })" href="@(FilterUrl(new Dictionary<string, object?> { ["status"] = null }))">Open <b>@(total - (int)(At(byStatus, "Released") ?? 0))</b></a>
          @foreach (var s in TruckLink.Models.StorageRequest.STATUSES) {<text>
          <a class="@Cls(new Dictionary<string, object?> { ["0"] = "chip text-decoration-none", ["chip-on"] = status == s })" href="@(FilterUrl(new Dictionary<string, object?> { ["status"] = s }))">@(s == "Reserved" ? "Expected" : s) <b>@((int)(At(byStatus, s) ?? 0))</b></a>
          </text>}
        </div>
        <div class="card-tl" style="overflow:hidden">
          <table class="tbl">
            <thead><tr><th>Booking</th><th>Customer</th><th>Volume</th><th>Free until</th><th>Release</th><th>Status</th><th style="width:330px">Bay</th></tr></thead>
            <tbody>
              @if (!IsEmpty(requests)) {<text>
@foreach (var storage in requests) {<text>
              <tr><td class="mono-d" style="font-weight:600;white-space:nowrap">@(storage.Booking.Reference)<div class="kv" style="font-family:inherit;font-weight:400">@(storage.Booking.BookingStatus)</div></td>
                <td>@(storage.Booking.Customer.FullName)</td><td class="mono-d">@(NumberFormat(storage.Booking.TotalVolumeM3, 2)) m³</td>
                <td>@(Format(storage.FreePeriodEndDate, "d M"))</td><td>@(Format(storage.EndDate, "d M Y") ?? "-")</td>
                <td>@await Component.InvokeAsync("StatusPill", new Dictionary<string, object?> { ["value"] = storage.StorageStatus })</td>
                <td>
                  @if (keeping.CanIntake(storage) || keeping.CanRelease(storage)) {<text>
                  <div class="d-flex gap-2 align-items-center">
                    <form method="POST" action="@(route(keeping.CanIntake(storage) ? "staff.warehouse.intake" : "staff.warehouse.move", storage))" class="d-flex gap-2">
                      @Html.AntiForgeryToken()
                      <input class="fld mono-d" name="storage_location" value="@(storage.StorageLocation)" required maxlength="8" pattern="^[A-Za-z]{2}-[A-Za-z]-[0-9]{2}$" title="e.g. RN-B-14" style="width:110px;padding-top:7px;padding-bottom:7px;text-transform:uppercase" aria-label="Bay for @(storage.Booking.Reference)">
                      <button type="submit" class="btn @(keeping.CanIntake(storage) ? "btn-tl" : "btn-out") b-sm" style="white-space:nowrap">@(keeping.CanIntake(storage) ? "Record intake" : "Move")</button>
                    </form>
                    @if (Truthy(keeping.CanRelease(storage))) {<text>
                    <form method="POST" action="@(route("staff.warehouse.release", storage))">@Html.AntiForgeryToken()<button type="submit" class="btn btn-out-dg b-sm" style="white-space:nowrap">Release</button></form>
                    </text>}
                  </div>
                  </text>} else {<text>
                  <span class="mono-d">@(storage.StorageLocation)</span>@if (storage.StorageStatus == "Reserved") {<text><div class="kv">Expected once picked up</div></text>}
                  </text>}
                </td></tr>
              </text>}
</text>} else {<text>
              <tr><td colspan="7" class="kv">Nothing here.</td></tr>
              </text>}
            </tbody>
          </table>
          @await Html.PartialAsync("~/Views/Shared/_Pager.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["paginator"] = requests, ["label"] = Plural("storage request", Total(requests)) }))
        </div>
}
