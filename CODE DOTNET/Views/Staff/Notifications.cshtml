
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
@{
    dynamic @new = ViewData["new"];
    dynamic notices = ViewData["notices"];
}



@{ ViewData["title"] = "Notifications"; }

@section Content {
        <div class="crumb"><b>Notifications</b></div>
        <div class="d-flex justify-content-between align-items-end mb-4">
          <div><h1 class="h-page">Notifications</h1><p class="h-sub">Job assignments and news from the operations team · also sent to @(User(auth("staff")).Email)</p></div>
        </div>
        <div class="card-tl p-4">
          @if (!IsEmpty(notices)) {<text>
@foreach (var (notice, loop) in WithLoop((object?)(notices))) {<text>
          @{
dynamic isNew = InArray(notice.AnnouncementId, @new, true);
}
          <div class="tl-item" @Html.Raw((Truthy(loop.Last) ? " style=\"padding-bottom:0\" " : ""))><div class="@Cls(new Dictionary<string, object?> { ["0"] = "tl-dot", ["tl-dot-mu"] = !isNew })"></div>
            <div style="flex:1">
              <div class="d-flex justify-content-between gap-3"><div style="font-weight:600;font-size:14.5px">@(notice.Title)@if (Truthy(isNew)) {<text> <span class="pill p-pend ms-1" style="font-size:11px;padding:3px 9px">New</span></text>}</div>
                <span class="kv" style="white-space:nowrap">@(Format(notice.SentAt, "d M Y, H:i"))</span></div>
              <div class="kv">@(notice.Content)</div>
              @if (notice.AnnouncementType == "Job Assigned" && PregMatch("/^BK-\\d{4}-(\\d{6})/", notice.Content, out dynamic m)) {<text>
              <a class="btn btn-out b-sm mt-2" href="@(route("staff.jobs.show", (int)At(m, 1)))">Open the job</a>
              </text>}
            </div></div>
          </text>}
</text>} else {<text>
          <div class="kv">No notifications yet.</div>
          </text>}
        </div>
        @if (Truthy(HasPages(notices))) {<text><div class="card-tl mt-3" style="overflow:hidden">@await Html.PartialAsync("~/Views/Shared/_Pager.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["paginator"] = notices, ["label"] = "notifications" }))</div></text>}
}
