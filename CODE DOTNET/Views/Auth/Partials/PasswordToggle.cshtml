
<script>
  
  document.querySelectorAll('[data-toggle-password]').forEach(function (icon) {
    function toggle() {
      var input = document.getElementById(icon.dataset.togglePassword);
      var show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      icon.classList.toggle('bi-eye-slash', !show);
      icon.classList.toggle('bi-eye', show);
      icon.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    }
    icon.addEventListener('click', toggle);
    icon.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } });
  });
</script>
