
@{ Layout = "~/Views/Shared/_CustomerLayout.cshtml"; }
@{
    dynamic @new = ViewData["new"];
    dynamic notices = ViewData["notices"];
}



@{ ViewData["title"] = "Notifications"; }

@{
dynamic icons = new Dictionary<string, object?> { ["Booking Accepted"] = "bi-check-circle", ["Booking Rejected"] = "bi-x-circle", ["Status Update"] = "bi-truck", ["Payment Confirmed"] = "bi-credit-card", ["Storage Reminder"] = "bi-alarm", ["Job Assigned"] = "bi-clipboard-check", ["Service Update"] = "bi-megaphone", ["Offer"] = "bi-gift" };
}

@section Content {
    <div class="page-head"><div><h1 class="h-page">Notifications</h1><p class="h-sub">Updates on your bookings and news from TruckLink - also sent to @(User(auth("customer")).Email)</p></div></div>
    <div class="card-tl" style="padding:26px">
      @if (!IsEmpty(notices)) {<text>
@foreach (var (notice, loop) in WithLoop((object?)(notices))) {<text>
      @{
dynamic isNew = InArray(notice.AnnouncementId, @new, true);
}
      <div class="tl-item" @Html.Raw((Truthy(loop.Last) ? " style=\"padding-bottom:0\" " : ""))><div class="@Cls(new Dictionary<string, object?> { ["0"] = "tl-dot", ["tl-dot-mu"] = !isNew })"></div>
        <div style="flex:1">
          <div class="d-flex justify-content-between gap-3"><div style="font-weight:600;font-size:14.5px"><i class="bi @(At(icons, notice.AnnouncementType) ?? "bi-bell") me-1" style="color:var(--s)"></i> @(notice.Title)@if (Truthy(isNew)) {<text> <span class="pill p-pend ms-1" style="font-size:11px;padding:3px 9px">New</span></text>}</div>
            <span class="kv" style="white-space:nowrap">@(Format(notice.SentAt, "d M Y, H:i"))</span></div>
          <div class="kv">@(notice.Content)</div>
        </div></div>
      </text>}
</text>} else {<text>
      <div class="kv">No notifications yet. We will let you know here as soon as your booking moves.</div>
      </text>}
    </div>
    @if (Truthy(HasPages(notices))) {<text><div class="card-tl mt-3" style="overflow:hidden">@await Html.PartialAsync("~/Views/Shared/_Pager.cshtml", Vd(ViewData, new Dictionary<string, object?> { ["paginator"] = notices, ["label"] = "notifications" }))</div></text>}
}
