
@{ Layout = "~/Views/Shared/_CustomerLayout.cshtml"; }
@{
    dynamic booking = ViewData["booking"];
    dynamic cities = ViewData["cities"];
    dynamic valueAdded = ViewData["valueAdded"];
}



@{ ViewData["title"] = "Edit " + booking.Reference; }

@{
dynamic value =  (Func<dynamic, dynamic, dynamic>)((key, @default) => old(key, @default));
dynamic lines = KeyBy(booking.BookingServices, "service_id");
dynamic extras = old("services") ? All(Map(Collect(old("services")),  (Func<dynamic, dynamic>)((s) => !IsEmpty(At(s, "selected")) ? Max(1, (int)(At(s, "quantity") ?? 1)) : 0))) : All(Filter(lines,  (Func<dynamic, dynamic>)((l) => l.Service.ServiceType == "Value-Added")).Map.Quantity);
dynamic accepted = booking.BookingStatus == "Accepted";
}

@section Content {
    <div class="crumb"><a href="@(route("customer.bookings.index"))" class="text-reset text-decoration-none">My Bookings</a> <i class="bi bi-chevron-right" style="font-size:9px"></i>
      <a href="@(route("customer.bookings.show", booking))" class="text-reset text-decoration-none">@(booking.Reference)</a> <i class="bi bi-chevron-right" style="font-size:9px"></i> <b>Edit</b></div>
    <div class="page-head"><div><h1 class="h-page">Edit @(booking.Reference)</h1><p class="h-sub">Change where and when@(booking.IsPending() ? ", and the extra services" : "") - until the crew picks up your items</p></div></div>
    <form method="POST" action="@(route("customer.bookings.update", booking))">
    @Html.AntiForgeryToken() <input type="hidden" name="_method" value="PUT"> 
    <div class="row g-3">
      <div class="col-8">
        <div class="card-tl mb-3" style="padding:26px">
          <div class="sec-head"><div class="sec-ic"><i class="bi bi-geo-alt"></i></div><div><h2 class="h-card">Pickup</h2><p class="kv mb-0">Where should the crew collect your items?</p></div></div>
          <div class="row g-3">
            <div class="col-8">@await Component.InvokeAsync("Field", new Dictionary<string, object?> { ["name"] = "pickup_address", ["label"] = "Pickup address", ["required"] = true, ["maxlength"] = "200", ["autocomplete"] = "street-address", ["value"] = booking.PickupAddress })</div>
            <div class="col-4">@{ PushWriter(new System.IO.StringWriter()); }
              <select id="pickup_city" name="pickup_city" class="@Cls(new Dictionary<string, object?> { ["0"] = "fld", ["fld-err"] = errors.Has("pickup_city") })" style="appearance:none" required>
                @foreach (var city in cities) {<text><option @(value("pickup_city", booking.PickupCity) == city ? "selected" : "")>@(city)</option></text>}
              </select>
            @{ var __slot1 = new HtmlString(PopWriter().ToString()); }@await Component.InvokeAsync("Field", new Dictionary<string, object?> { ["name"] = "pickup_city", ["label"] = "Pickup city", ["required"] = true, ["slot"] = __slot1 })</div>
          </div>
        </div>
        <div class="card-tl mb-3" style="padding:26px">
          <div class="sec-head"><div class="sec-ic"><i class="bi bi-flag"></i></div><div><h2 class="h-card">Drop-off</h2><p class="kv mb-0">Where are we delivering to?</p></div></div>
          <div class="row g-3">
            <div class="col-8">@await Component.InvokeAsync("Field", new Dictionary<string, object?> { ["name"] = "dropoff_address", ["label"] = "Drop-off address", ["required"] = true, ["maxlength"] = "200", ["value"] = booking.DropoffAddress })</div>
            <div class="col-4">@{ PushWriter(new System.IO.StringWriter()); }
              <select id="dropoff_city" name="dropoff_city" class="@Cls(new Dictionary<string, object?> { ["0"] = "fld", ["fld-err"] = errors.Has("dropoff_city") })" style="appearance:none" required>
                @foreach (var city in cities) {<text><option @(value("dropoff_city", booking.DropoffCity) == city ? "selected" : "")>@(city)</option></text>}
              </select>
            @{ var __slot2 = new HtmlString(PopWriter().ToString()); }@await Component.InvokeAsync("Field", new Dictionary<string, object?> { ["name"] = "dropoff_city", ["label"] = "Drop-off city", ["required"] = true, ["slot"] = __slot2 })</div>
          </div>
        </div>
        <div class="card-tl mb-3" style="padding:26px">
          <div class="sec-head"><div class="sec-ic"><i class="bi bi-calendar3"></i></div><div><h2 class="h-card">Schedule</h2><p class="kv mb-0">Pick a date and time that suits you.</p></div></div>
          <div class="row g-3">
            <div class="col-4">@await Component.InvokeAsync("Field", new Dictionary<string, object?> { ["name"] = "pickup_date", ["label"] = "Pickup date", ["type"] = "date", ["required"] = true, ["min"] = ToDateString(now()), ["value"] = ToDateString(booking.PickupDatetime) })</div>
            <div class="col-4">@await Component.InvokeAsync("Field", new Dictionary<string, object?> { ["name"] = "pickup_time", ["label"] = "Pickup time", ["type"] = "time", ["required"] = true, ["value"] = Format(booking.PickupDatetime, "H:i") })</div>
            <div class="col-4"><label class="lbl">Expected delivery</label><input class="fld fld-dis" value="@(Format(booking.ExpectedDeliveryDatetime, "d M Y, H:i"))" disabled></div>
          </div>
          <div class="mt-3">@{ PushWriter(new System.IO.StringWriter()); }
            <textarea id="customer_notes" name="customer_notes" class="@Cls(new Dictionary<string, object?> { ["0"] = "fld", ["fld-err"] = errors.Has("customer_notes") })" rows="2" maxlength="240">@(value("customer_notes", booking.CustomerNotes))</textarea>
          @{ var __slot3 = new HtmlString(PopWriter().ToString()); }@{ PushWriter(new System.IO.StringWriter()); }Notes for the crew <span style="color:var(--mu);font-weight:500">- optional</span>@{ var __slot4 = new HtmlString(PopWriter().ToString()); }@await Component.InvokeAsync("Field", new Dictionary<string, object?> { ["name"] = "customer_notes", ["maxlength"] = "240", ["slot"] = __slot3, ["label"] = __slot4 })</div>
          @if (Truthy(booking.StorageRequest)) {<text>
          <div class="al a-in mt-3" style="font-size:13.5px"><i class="bi bi-buildings-fill" style="font-size:16px"></i><div>Your Premium Storage moves with the pickup day, so its price stays the same. Change the release date on the <a href="@(route("customer.storage"))"><b>Storage</b></a> page.</div></div>
          </text>}
        </div>
        @if (Truthy(IsNotEmpty(valueAdded))) {<text>
        <div class="card-tl" style="padding:26px">
          <div class="sec-head"><div class="sec-ic"><i class="bi bi-tools"></i></div><div><h2 class="h-card">Extra services</h2><p class="kv mb-0">Each is charged separately - pay only for what you use.</p></div></div>
          @foreach (var (service, loop) in WithLoop((object?)(valueAdded))) {<text>
          @{
dynamic qty = (int)(At(extras, service.ServiceId) ?? 0);
}
          <div class="@Cls(new Dictionary<string, object?> { ["0"] = "pick d-flex align-items-center gap-3", ["pick-on"] = qty > 0, ["mb-2"] = !loop.Last })" data-extra>
            <input class="form-check-input" type="checkbox" name="services[@(service.ServiceId)][selected]" value="1" @(qty > 0 ? "checked" : "") style="margin:0;width:19px;height:19px" aria-label="@(service.ServiceName)">
            <div class="@Cls(new Dictionary<string, object?> { ["0"] = "ic-box", ["ic-on"] = qty > 0 })"><i class="bi @(At(TruckLink.Models.Service.ICONS, service.ServiceName) ?? "bi-plus-circle")"></i></div>
            <div style="flex:1"><div style="font-weight:700;font-size:15.5px">@(service.ServiceName)</div><div class="kv">@(Sar(service.BasePrice)) SAR @(service.PricingUnit)</div></div>
            <div class="d-flex align-items-center gap-2"><button type="button" class="btn btn-out b-ico" style="width:34px;height:34px" data-step="-1" aria-label="Fewer"><i class="bi bi-dash-lg"></i></button><input class="fld text-center" style="width:58px;padding:7px" name="services[@(service.ServiceId)][quantity]" value="@(qty)" inputmode="numeric" pattern="[0-9]{1,2}" maxlength="2" aria-label="Quantity"><button type="button" class="btn btn-out b-ico" style="width:34px;height:34px" data-step="1" aria-label="More"><i class="bi bi-plus-lg"></i></button></div>
          </div>
          </text>}
          @if (errors.Has("services.*")) { var message = errors.First("services.*");<text><div class="err mt-2"><i class="bi bi-exclamation-circle-fill"></i> @(message)</div></text>}
        </div>
        </text>}
      </div>
      <div class="col-4">
        <div class="card-tl summary" style="padding:24px">
          <div class="sum-cap mb-3">Your booking</div>
          <div class="sum-row"><span>Status</span><span>@await Component.InvokeAsync("StatusPill", new Dictionary<string, object?> { ["value"] = booking.BookingStatus })</span></div>
          <div class="sum-row"><span>Route</span><span>@(booking.PickupCity) → @(booking.DropoffCity)</span></div>
          <div class="sum-row"><span>Pickup</span><span>@(Format(booking.PickupDatetime, "d M, H:i"))</span></div>
          <div class="sum-row"><span>Vehicle</span><span>@(booking.RecommendedVehicleType)</span></div>
          <div class="tot-box mt-3"><span class="t-l">Total so far</span><span class="t-v">@(Sar(booking.TotalAmount)) SAR</span></div>
        </div>
        @if (Truthy(accepted)) {<text>
        <div class="al a-wn mt-3"><i class="bi bi-exclamation-triangle-fill" style="font-size:18px"></i><div><b>Already accepted</b><div style="margin-top:6px">Changing the route or the pickup time sends the booking back to TruckLink for a new approval and releases the reserved vehicle and driver. Notes can be changed freely.</div></div></div>
        </text>} else {<text>
        <div class="al a-in mt-3"><i class="bi bi-info-circle-fill" style="font-size:18px"></i><div>Items and the vehicle come from the measurement and cannot be changed here. To change them, cancel this request and create a new one.</div></div>
        </text>}
      </div>
    </div>
    <div class="d-flex justify-content-between mt-4"><a class="btn btn-out b-md" href="@(route("customer.bookings.show", booking))"><i class="bi bi-arrow-left"></i> Back</a><button type="submit" class="btn btn-tl b-lg"><i class="bi bi-check-lg"></i> Save changes</button></div>
    </form>
}

@section Scripts {
<script>
  
  document.querySelectorAll('[data-extra]').forEach(function (row) {
    var box = row.querySelector('input[type=checkbox]'), qty = row.querySelector('input[name$="[quantity]"]');
    function paint() { row.classList.toggle('pick-on', box.checked); row.classList.toggle('pick', true); row.querySelector('.ic-box').classList.toggle('ic-on', box.checked); }
    row.querySelectorAll('[data-step]').forEach(function (b) {
      b.addEventListener('click', function () {
        var n = Math.max(0, Math.min(20, (parseInt(qty.value, 10) || 0) + Number(b.dataset.step)));
        qty.value = n; box.checked = n > 0; paint();
      });
    });
    box.addEventListener('change', function () { if (box.checked && !(parseInt(qty.value, 10) > 0)) qty.value = 1; if (!box.checked) qty.value = 0; paint(); });
  });
</script>
}
