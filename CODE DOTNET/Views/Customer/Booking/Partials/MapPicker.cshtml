
@{
    dynamic lat = ViewData["lat"];
    dynamic lng = ViewData["lng"];
    dynamic side = ViewData["side"];
}



@{
dynamic hasPin = lat != null && lat != "" && lng != null && lng != "";
}
<div class="mt-3" data-map-picker="@(side)" data-city-field="@(side)_city" data-address-field="@(side)_address">
  <input type="hidden" name="@(side)_lat" value="@(lat)" data-map-lat>
  <input type="hidden" name="@(side)_lng" value="@(lng)" data-map-lng>
  <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
    <span class="kv" data-map-status>@if (Truthy(hasPin)) {<text><i class="bi bi-geo-alt-fill" style="color:var(--p)"></i> Pinned on the map </text>} else {<text><i class="bi bi-cursor"></i> Search, tap the map or drag the pin to fill the address </text>}</span>
    <span class="d-flex gap-2">
      <button type="button" class="btn btn-ghost b-sm" data-map-locate><i class="bi bi-crosshair"></i> Use my location</button>
      <button type="button" class="btn btn-ghost b-sm" data-map-toggle><i class="bi bi-keyboard"></i> <span>Type the address instead</span></button>
    </span>
  </div>
  <div class="map-box" data-map-box>
    <div class="map-search">
      <i class="bi bi-search"></i>
      <input type="search" class="fld" placeholder="Search a street, district or landmark" autocomplete="off" aria-label="Search the map" data-map-search>
      <ul class="map-results" role="listbox" hidden data-map-results></ul>
    </div>
    <div class="map-canvas" data-map-canvas aria-label="Map of the @(side == "pickup" ? "pickup" : "drop-off") location"></div>
  </div>
</div>


@section Styles {
<link rel="stylesheet" href="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
}
@section Scripts {
<script src="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
  
  (function () {
    var cities = @(JsFrom(config("trucklink.city_coords")));
    var NOMINATIM = 'https://nominatim.openstreetmap.org/';
    var pinIcon = L.divIcon({ className: 'map-pin', html: '<i class="bi bi-geo-alt-fill"></i>', iconSize: [34, 34], iconAnchor: [17, 32] });

    
    function shortAddress(a, fallback) {
      if (!a) return fallback || '';
      var street = [a.house_number, a.road || a.pedestrian || a.street].filter(Boolean).join(' ');
      var parts = [a.amenity || a.building || a.shop || a.office, street, a.neighbourhood || a.suburb || a.quarter || a.city_district]
        .filter(function (p, i, all) { return p && all.indexOf(p) === i; });
      return (parts.join(', ') || fallback || '').slice(0, 200);
    }

    document.querySelectorAll('[data-map-picker]').forEach(function (box) {
      var form = box.closest('form');
      var city = form.querySelector('[name="' + box.dataset.cityField + '"]');
      var address = form.querySelector('[name="' + box.dataset.addressField + '"]');
      var lat = box.querySelector('[data-map-lat]'), lng = box.querySelector('[data-map-lng]');
      var search = box.querySelector('[data-map-search]'), results = box.querySelector('[data-map-results]');
      var status = box.querySelector('[data-map-status]'), panel = box.querySelector('[data-map-box]');
      var toggle = box.querySelector('[data-map-toggle]');
      var centre = function () { return cities[city.value] || cities.Riyadh; };
      var start = lat.value && lng.value ? [Number(lat.value), Number(lng.value)] : centre();

      var map = L.map(box.querySelector('[data-map-canvas]'), { zoomControl: false, scrollWheelZoom: false }).setView(start, lat.value ? 16 : 12);
      L.control.zoom({ position: 'bottomright' }).addTo(map);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
      }).addTo(map);
      var marker = null;

      function say(html) { status.innerHTML = html; }
      function place(latlng, label) {
        if (!marker) {
          marker = L.marker(latlng, { icon: pinIcon, draggable: true, autoPan: true }).addTo(map);
          marker.on('dragend', function () { reverse(marker.getLatLng()); });
        } else { marker.setLatLng(latlng); }
        lat.value = Number(latlng.lat).toFixed(6);
        lng.value = Number(latlng.lng).toFixed(6);
        if (label !== undefined) { address.value = label; address.dispatchEvent(new Event('input', { bubbles: true })); }
        say('<i class="bi bi-geo-alt-fill" style="color:var(--p)"></i> Pinned on the map - edit the address above if needed');
      }
      function reverse(latlng) {
        say('<i class="bi bi-arrow-repeat"></i> Finding the address…');
        place(latlng);
        fetch(NOMINATIM + 'reverse?format=jsonv2&accept-language=en&zoom=18&lat=' + latlng.lat + '&lon=' + latlng.lng)
          .then(function (r) { return r.json(); })
          .then(function (d) { place(latlng, shortAddress(d.address, d.name || address.value)); })
          .catch(function () { say('<i class="bi bi-exclamation-circle"></i> Pinned - type the street and building number above'); });
      }
      if (lat.value && lng.value) place(start);

      map.on('click', function (e) { reverse(e.latlng); });

      
      var timer = null, last = '';
      search.addEventListener('input', function () {
        clearTimeout(timer);
        var q = search.value.trim();
        if (q.length < 3) { results.hidden = true; return; }
        timer = setTimeout(function () {
          if (q === last) return;
          last = q;
          var c = centre(), d = 0.35;
          var url = NOMINATIM + 'search?format=jsonv2&addressdetails=1&accept-language=en&countrycodes=sa&limit=6&bounded=1'
            + '&viewbox=' + (c[1] - d) + ',' + (c[0] + d) + ',' + (c[1] + d) + ',' + (c[0] - d) + '&q=' + encodeURIComponent(q);
          fetch(url).then(function (r) { return r.json(); }).then(function (list) {
            results.innerHTML = '';
            if (!list.length) { results.innerHTML = '<li class="map-empty">No place found in ' + (city.value || 'this city') + '</li>'; }
            list.forEach(function (item) {
              var li = document.createElement('li');
              li.setAttribute('role', 'option');
              li.tabIndex = 0;
              li.innerHTML = '<i class="bi bi-geo-alt"></i><span></span>';
              li.querySelector('span').textContent = item.display_name.split(', Saudi Arabia')[0];
              function choose() {
                var ll = L.latLng(Number(item.lat), Number(item.lon));
                map.setView(ll, 17);
                place(ll, shortAddress(item.address, item.name || item.display_name.split(',')[0]));
                results.hidden = true; search.value = '';
              }
              li.addEventListener('click', choose);
              li.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); choose(); } });
              results.appendChild(li);
            });
            results.hidden = false;
          }).catch(function () { results.innerHTML = '<li class="map-empty">Search is unavailable - type the address above</li>'; results.hidden = false; });
        }, 450);
      });
      search.addEventListener('keydown', function (e) { if (e.key === 'Enter') e.preventDefault(); });   
      document.addEventListener('click', function (e) { if (!box.contains(e.target)) results.hidden = true; });

      
      city.addEventListener('change', function () {
        map.setView(centre(), 12);
        if (marker) { map.removeLayer(marker); marker = null; }
        lat.value = ''; lng.value = '';
        say('<i class="bi bi-cursor"></i> Search, tap the map or drag the pin to fill the address');
      });

      box.querySelector('[data-map-locate]').addEventListener('click', function () {
        if (!navigator.geolocation) return;
        say('<i class="bi bi-arrow-repeat"></i> Locating you…');
        navigator.geolocation.getCurrentPosition(function (p) {
          var ll = L.latLng(p.coords.latitude, p.coords.longitude);
          map.setView(ll, 17); reverse(ll);
        }, function () { say('<i class="bi bi-exclamation-circle"></i> Location is blocked - search or tap the map instead'); });
      });

      
      toggle.addEventListener('click', function () {
        var hide = !panel.hidden;
        panel.hidden = hide;
        box.querySelector('[data-map-locate]').hidden = hide;
        toggle.querySelector('span').textContent = hide ? 'Choose on the map' : 'Type the address instead';
        toggle.querySelector('i').className = 'bi ' + (hide ? 'bi-map' : 'bi-keyboard');
        if (hide) { lat.value = ''; lng.value = ''; if (marker) { map.removeLayer(marker); marker = null; } say('<i class="bi bi-keyboard"></i> Type the full address above'); address.focus(); }
        else { setTimeout(function () { map.invalidateSize(); }, 50); say('<i class="bi bi-cursor"></i> Search, tap the map or drag the pin to fill the address'); }
      });
    });
  })();
</script>
}

