
@{
    dynamic item = ViewData["item"];
    dynamic small = ViewData["small"];
}


@{ dynamic photo = First(item.Photos); }
@if (Truthy(photo)) {<text>
<div class="@((small ?? false) ? "thumb-sm" : "thumb")" style="overflow:hidden"><img src="@(photo.Src)" alt="" style="width:100%;height:100%;object-fit:cover"></div>
</text>} else {<text>
<div class="@((small ?? false) ? "thumb-sm" : "thumb")">@await Html.PartialAsync((string)TlView(item.IllustrationView(small ?? false)))</div>
</text>}
